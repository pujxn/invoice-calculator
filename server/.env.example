# Port for the API server
PORT=4000

# --- Login ---
# Key used to hash one-time codes. Leave empty to generate a random one at each start
# (codes in flight are then lost on restart). Set a long random string to keep them.
AUTH_SECRET=

# --- SMS (OTP delivery) ---
# "console" (default) prints the OTP to the server log, no credentials needed.
# "twilio" sends a real SMS.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- AI image recognition ---
# "claude" uses the Anthropic API. "mock" skips AI so you type the amounts yourself.
# If unset, defaults to "claude" when ANTHROPIC_API_KEY is set, otherwise "mock".
VISION_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
