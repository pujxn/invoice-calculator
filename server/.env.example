# Port for the API server
PORT=4000

# --- Running on a real server ---
# NODE_ENV=production makes start-up warn if codes would be printed to the log (SMS_PROVIDER=console),
# if the AI is the mock, or if AUTH_SECRET is empty.
# NODE_ENV=production
# How many proxies sit in front of this server (usually 1 behind a load balancer). Leave unset when
# there is none; set it wrongly and per-IP limits see the proxy instead of the visitor.
# TRUST_PROXY=1

# --- Login ---
# Key used to hash one-time codes. Leave empty to generate a random one at each start
# (codes in flight are then lost on restart). Set a long random string to keep them.
AUTH_SECRET=
# Optional: per-IP caps per 15 minutes on code requests (default 20) and code checks (default 40).
# AUTH_IP_REQUEST_LIMIT=20
# AUTH_IP_VERIFY_LIMIT=40

# --- Roles: superadmin and agents ---
# Only these numbers and the agents a superadmin adds can sign in. List the superadmins' mobile
# numbers (comma separated, with country code). Left empty, a local demo (console SMS, not
# production) uses +919999900000 so you can try it with no set-up; set your own for a real server.
SUPERADMIN_PHONES=
# Where the agents a superadmin adds are kept (default: server/data/agents.json, ignored by git).
# Set to "memory" to keep them only until the server stops.
# AGENTS_FILE=

# --- Invoice picture uploads ---
# Where uploaded pictures are kept (default: server/uploads, ignored by git).
# UPLOAD_DIR=
# Largest picture accepted, in MB (default 10).
# UPLOAD_MAX_MB=10
# Pictures are deleted automatically after this many hours (default 24).
# UPLOAD_TTL_HOURS=24
# How many pictures one user can keep at once (default 50).
# UPLOAD_MAX_PER_USER=50

# --- Saved invoice history ---
# Where saved history is kept (default: server/data/history.json, ignored by git).
# Set to "memory" to keep history only until the server stops.
# HISTORY_FILE=

# --- SMS (OTP delivery) ---
# "console" (default) prints the OTP to the server log, no credentials needed.
# "twilio" sends a real SMS.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Reading the invoice picture ---
# "ocr"    free, runs on this server, works offline (the default when there is no key).
# "claude" the Anthropic API (the default when ANTHROPIC_API_KEY is set).
# "mock"   made-up demo numbers, the picture is not read (used by the automated tests).
# The "Read with" switch on the upload screen lets people choose "ocr" or "claude" per picture
# (AI shows as unavailable without a key). This setting only picks the default.
VISION_PROVIDER=
# Give up on one local OCR reading after this many seconds (default 45).
# OCR_TIMEOUT_SECONDS=45
# 1 = when OCR is not sure of the amounts, let Claude read the picture instead (needs the key).
# OCR_FALLBACK_TO_CLAUDE=0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# How hard the model thinks: low, medium (default), high, xhigh, max, or none to leave it to the API.
# ANTHROPIC_EFFORT=medium
# Give up on one AI call after this many seconds (default 60).
# ANTHROPIC_TIMEOUT_SECONDS=60
# Set to "default" to let the API retry a request the model declined on another model.
# ANTHROPIC_FALLBACKS=
# How many readings one user can start per hour (default 30). Each real reading costs money.
# EXTRACT_PER_USER_PER_HOUR=30

# --- Mobile apps (iOS and Android) ---
# The Ledgerly apps are always allowed (capacitor://localhost, https://localhost, http://localhost).
# List any other website that may call this API from a browser, separated by commas.
# CORS_ORIGINS=https://app.example.com
