{
  "name": "invoice-calculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:phone": "node scripts/phone.mjs",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm test --workspaces --if-present && npm run test:scripts",
    "brand": "node scripts/build-brand.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ui": "playwright test",
    "test:ui:screens": "SCREENSHOTS=1 playwright test",
    "test:scripts": "node --test scripts/test/*.test.mjs",
    "native:sync": "node scripts/native.mjs sync",
    "native:sync:production": "node scripts/native.mjs sync --production",
    "native:android": "node scripts/native.mjs open android",
    "native:ios": "node scripts/native.mjs open ios",
    "native:run:android": "node scripts/native.mjs run android",
    "native:run:ios": "node scripts/native.mjs run ios",
    "native:assets": "npm run assets -w client"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.4.0",
    "qrcode-terminal": "^0.12.0"
  }
}
